# Metin dosyalarinda satir sonu normalize edilsin: depoda LF, calisma
# kopyasinda isletim sisteminin kendi bicimi. Boylece Windows ve Linux'ta
# calisan katkicilar arasinda sahte degisiklikler olusmuyor.
* text=auto eol=lf

# Ikili dosyalar dokunulmasin: normalize edilirse bozuluyorlar.
*.ttf binary
*.ico binary
*.png binary
*.bmp binary
*.pdf binary
*.exe binary

# Windows'a ozgu betikler CRLF olmali.
*.bat text eol=crlf
*.cmd text eol=crlf

# GitHub dil istatistiklerinde uretilen varliklar sayilmasin.
assets/installer/* linguist-generated=true
arayuz/* linguist-documentation=true
